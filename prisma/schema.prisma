generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  children  Child[]

  @@map("institutions")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  name             String
  role             UserRole
  cedula           String?           @unique
  phone            String?
  telegramChatId   String?           // Chat ID de Telegram para notificaciones
  isActive         Boolean           @default(true)
  institutionId    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  institution      Institution?      @relation(fields: [institutionId], references: [id])
  children         Child[]
  withdrawalOrders WithdrawalOrder[]

  @@map("users")
}

model Child {
  id               String            @id @default(cuid())
  name             String
  grade            String
  school           String
  parentId         String
  institutionId    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  parent           User              @relation(fields: [parentId], references: [id], onDelete: Cascade)
  institution      Institution?      @relation(fields: [institutionId], references: [id])
  withdrawalOrders WithdrawalOrder[]

  @@map("children")
}

model Picker {
  id                String          @id @default(cuid())
  name              String
  cedula            String          @unique
  phone             String
  relationship      String
  withdrawalOrderId String          @unique
  createdAt         DateTime        @default(now())
  codeExpiresAt     DateTime?
  isActive          Boolean         @default(true)
  temporaryPassword String?
  updatedAt         DateTime        @updatedAt
  encryptedCode     String?
  withdrawalOrder   WithdrawalOrder @relation(fields: [withdrawalOrderId], references: [id], onDelete: Cascade)

  @@map("pickers")
}

model WithdrawalOrder {
  id             String           @id @default(cuid())
  childId        String
  parentId       String
  status         WithdrawalStatus @default(PENDING)
  qrCode         String?
  withdrawalDate DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  picker         Picker?
  child          Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent         User             @relation(fields: [parentId], references: [id], onDelete: Cascade)
  withdrawalLog  WithdrawalLog?

  @@map("withdrawal_orders")
}

model WithdrawalLog {
  id                String          @id @default(cuid())
  withdrawalOrderId String          @unique
  pickerCedula      String
  pickerName        String
  childName         String
  parentName        String
  completedAt       DateTime        @default(now())
  completedBy       String          // ID del guardia/admin que completó
  createdAt         DateTime        @default(now())
  withdrawalOrder   WithdrawalOrder @relation(fields: [withdrawalOrderId], references: [id], onDelete: Cascade)

  @@index([pickerCedula])
  @@index([completedAt])
  @@map("withdrawal_logs")
}

enum UserRole {
  PARENT
  GUARDIAN
  ADMIN
  PICKER
  GESTOR
}

enum WithdrawalStatus {
  PENDING
  VALIDATED
  COMPLETED
  CANCELLED
}
